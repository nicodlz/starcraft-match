{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:starcraft-match:function:v1",
  "title": "Function record and agent task",
  "type": "object",
  "required": ["schema_version", "address", "size", "name", "confidence", "references", "calls", "strings", "status", "boundary_verified", "binary_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "address": {"type": "string", "pattern": "^0x[0-9A-F]{8}$"},
    "binary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "size": {"type": ["integer", "null"], "minimum": 1},
    "name": {"type": ["string", "null"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "references": {"type": "array"},
    "calls": {"type": "array"},
    "strings": {"type": "array"},
    "status": {"enum": ["unknown", "identified", "prototype_known", "source_reconstructed", "compiling", "semantic_match", "assembly_partial_match", "exact_match"]},
    "boundary_verified": {"type": "boolean"},
    "provenance": {"type": "string"},
    "match_expectation": {"enum": ["exact", "exploratory"]},
    "candidate_source": {"type": ["string", "null"]},
    "calling_convention": {"type": ["string", "null"]},
    "prototype": {"type": ["string", "null"]},
    "dependencies": {"type": "array"},
    "linking": {
      "type": "object",
      "required": [
        "schema_version",
        "profile",
        "section",
        "bindings",
        "excluded_contexts"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "profile": {
          "type": "string"
        },
        "section": {
          "type": "string",
          "pattern": "^\\.[A-Za-z0-9_]{1,7}(\\$[a-z])?$"
        },
        "retained_functions": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "required": [
              "symbol",
              "section",
              "address",
              "size",
              "evidence"
            ],
            "properties": {
              "symbol": {
                "type": "string"
              },
              "section": {
                "type": "string",
                "pattern": "^\\.[A-Za-z0-9_]{1,7}(\\$[a-z])?$"
              },
              "address": {
                "type": "integer",
                "minimum": 4194304,
                "maximum": 4294967295
              },
              "size": {
                "type": "integer",
                "minimum": 1
              },
              "evidence": {
                "type": "array",
                "minItems": 1
              }
            },
            "additionalProperties": false
          }
        },
        "bindings": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "address",
              "kind",
              "evidence"
            ],
            "properties": {
              "address": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "kind": {
                "enum": [
                  "code",
                  "data"
                ]
              },
              "evidence": {
                "type": "array",
                "minItems": 1
              }
            },
            "additionalProperties": false
          }
        },
        "excluded_contexts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "symbol",
              "section"
            ],
            "properties": {
              "symbol": {
                "type": "string"
              },
              "section": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"profile": {"const": "gnu-i386pe-leaf-v1"}}},
          "then": {
            "required": ["retained_functions"],
            "properties": {"retained_functions": {"maxItems": 0}}
          },
          "else": {"properties": {"retained_functions": {"minItems": 1}}}
        }
      ],
      "additionalProperties": false
    },
    "match": {
      "type": "object",
      "properties": {
        "exact": {"type": ["boolean", "null"]},
        "score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "semantic": {"type": ["boolean", "null"]},
        "cfg": {"type": ["number", "null"]}
      }
    },
    "decompiler_output": {"type": ["string", "null"]},
    "original_asm": {"type": ["array", "string", "null"]},
    "known_structures": {"type": "array"},
    "known_calls": {"type": "array"},
    "notes": {"type": "array"}
  },
  "additionalProperties": true
}
