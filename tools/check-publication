#!/usr/bin/env python3
"""Reject private artifacts and proprietary binary containers in tracked/staged files."""
from pathlib import Path
import subprocess
import sys
ROOT = Path(__file__).resolve().parents[1]
staged = '--staged' in sys.argv
cmd = ['git', 'diff', '--cached', '--name-only', '--diff-filter=ACMR', '-z'] if staged else ['git', 'ls-files', '-z']
names = subprocess.check_output(cmd, cwd=ROOT).decode().split('\0')
errors = []
for name in filter(None, names):
    p = Path(name)
    if p.parts[0] in {'original', 'downloads', 'analysis', 'build', '.local'} or p.suffix.lower() in {'.exe', '.dll', '.mpq', '.zip', '.obj', '.o', '.bin', '.sqlite', '.db'}:
        errors.append(name)
        continue
    content = subprocess.check_output(['git', 'show', ':'+name], cwd=ROOT) if staged else (ROOT/p).read_bytes()
    if content[:2] == b'MZ' or content[:4] in (b'MPQ\x1a', b'PK\x03\x04', b'\x7fELF'):
        errors.append(name)
if errors:
    print('Refusing private/binary artifacts: '+', '.join(errors), file=sys.stderr)
    sys.exit(1)
print(f'Publication check passed ({len(list(filter(None, names)))} files)')
