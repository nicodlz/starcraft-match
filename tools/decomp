#!/usr/bin/env python3
"""Automation primitive: pin, analyze, compile, compare, and export one task."""
import argparse
import hashlib
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path
ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / 'tools'))
from analysis.pe import PE, hx
from matching.compare import coff_function, compare
from matching.linking import link_external_candidate
from matching.components import link_component_candidate
from matching.ltcg import link_ltcg_candidate


def read(path):
    return json.loads(Path(path).read_text())


def write(path, obj):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(obj, indent=2, sort_keys=True) + '\n')


def private(path):
    p = Path(path).resolve()
    if not any(p.is_relative_to(ROOT / d) for d in ('analysis', 'build', '.local')):
        raise ValueError('Generated artifacts must stay under analysis/, build/, or .local/ (gitignored)')
    return p


def binary(path, allow=False):
    pe = PE(path)
    supported = read(ROOT/'config/target.json')['supported_binaries']
    pe.metadata['target_supported'] = any(x['sha256'] == pe.metadata['sha256'] for x in supported)
    pe.metadata['version_verified'] = pe.metadata['target_supported']
    if not allow and not pe.metadata['target_supported']:
        raise ValueError('Unsupported SHA-256: inspect with analyze --allow-unverified; do not use for target matching')
    return pe


def records():
    catalog = {r['address']: r for r in read(ROOT/'config/functions.json')}
    discovered = ROOT/'analysis/functions.json'
    if discovered.exists():
        supported = {b['sha256'] for b in read(ROOT/'config/target.json')['supported_binaries']}
        for r in read(discovered):
            if r.get('binary_sha256') in supported:
                catalog.setdefault(r['address'], r)
    return sorted(catalog.values(), key=lambda r: r['address'])


def function(address):
    key = hx(int(address, 0))
    for r in records():
        if r['address'] == key:
            return r
    raise ValueError(f'Unknown function {key}')


def analyze(args):
    pe = binary(args.binary, args.allow_unverified)
    out = private(args.out)
    funcs = []
    seeds = [(pe.metadata['entry_point'], 'PE entry point')]
    symbols = pe.exports()
    seeds += [(s['address'], 'PE export') for s in symbols if s['address']]
    for addr, source in sorted(set(seeds)):
        funcs.append(dict(schema_version=1, address=addr, size=None, name=None, confidence=0.2,
                          references=[], calls=[], strings=[], status='unknown',
                          boundary_verified=False, provenance=source, binary_sha256=pe.metadata['sha256']))
    if pe.metadata['target_supported']:
        catalog = read(ROOT/'config/functions.json')
        funcs = [f for f in funcs if f['address'] not in {c['address'] for c in catalog}] + catalog
    for filename, data in [('binary', pe.metadata), ('imports', pe.imports()), ('sections', pe.sections),
                           ('strings', pe.strings()), ('functions', sorted(funcs, key=lambda f: f['address'])),
                           ('symbols', symbols)]:
        write(out/f'{filename}.json', data)
    print(f'Analyzed {pe.metadata["sha256"]}; {len(funcs)} function records (not a total function census)')


def compiler_digest(executable):
    resolved = shutil.which(executable)
    if not resolved:
        raise OSError(f'Compiler not available: {executable}')
    return hashlib.sha256(Path(resolved).read_bytes()).hexdigest()



class OptionalCompilerUnavailable(OSError):
    """Only absent default optional toolchains qualify for build-all fallback."""


def compiler_identity(profile):
    arguments = profile.get('identity_arguments')
    if arguments is None:
        return None
    if not isinstance(arguments, list) or not all(isinstance(a, str) for a in arguments):
        raise ValueError('identity_arguments must be an argument list')
    proc = subprocess.run([profile['executable'], *arguments], capture_output=True, text=True)
    try:
        identity = json.loads(proc.stdout)
    except (ValueError, TypeError) as error:
        raise OSError('Compiler identity was not valid JSON: ' + proc.stderr) from error
    if not isinstance(identity, dict):
        raise OSError('Compiler identity must be an object')
    if identity.get('status') == 'unavailable' and proc.returncode == 69:
        raise OptionalCompilerUnavailable(identity.get('reason', 'Optional compiler unavailable'))
    if proc.returncode or identity.get('status') != 'available':
        raise OSError('Compiler identity failed: ' + json.dumps(identity, sort_keys=True))
    return identity


def json_digest(value):
    return hashlib.sha256(json.dumps(value, sort_keys=True, separators=(',', ':')).encode()).hexdigest()


def file_digest(path):
    return hashlib.sha256(Path(path).read_bytes()).hexdigest()


def linker_state(r):
    if not r.get('linking'):
        return None
    spec = r['linking']
    config = read(ROOT/'config/linkers.json')[spec['profile']]
    if config.get('mode') == 'native-msvc71-ltcg-component-v1':
        required = dict(emulation='i386pe', image_base='0x00400000', section_alignment=16,
                        file_alignment=16, timestamps=True, base_relocations=False)
        if any(config.get(k) != v for k, v in required.items()):
            raise ValueError('Unsupported native LTCG linker configuration')
        identity = compiler_identity(config)
        executable = str(Path(config['executable']).resolve())
        return dict(config=config, executable=executable, sha256=file_digest(executable),
                    version=identity['version'], emulation='i386pe', identity=identity,
                    adapter_sha256=file_digest(ROOT/'tools/matching/ltcg.py'),
                    common_reader_sha256=file_digest(ROOT/'tools/matching/linking.py'),
                    instruction_reader_sha256=file_digest(ROOT/'tools/matching/compare.py'))
    required = dict(emulation='i386pe', image_base='0x00400000', section_alignment=16,
                    file_alignment=16, timestamps=False, base_relocations=False,
                    mode=config.get('mode'))
    if config.get('mode') not in ('external-only-whole-contribution-v1', 'compiled-component-v1'):
        raise ValueError('Unsupported standard linker mode')
    if any(config.get(k) != v for k, v in required.items()):
        raise ValueError('Unsupported standard linker configuration')
    executable = shutil.which(config['executable'])
    if not executable:
        raise OSError('Standard linker unavailable: ' + config['executable'])
    executable = str(Path(executable).resolve())
    version = subprocess.check_output([executable, '--version'], text=True).splitlines()[0]
    adapter = 'components.py' if config['mode'] == 'compiled-component-v1' else 'linking.py'
    return dict(config=config, executable=executable, sha256=file_digest(executable),
                version=version, emulation='i386pe',
                adapter_sha256=file_digest(ROOT/'tools/matching'/adapter),
                common_reader_sha256=file_digest(ROOT/'tools/matching/linking.py'))


def linked_method(state):
    if state['config']['mode'] == 'native-msvc71-ltcg-component-v1':
        return 'native-msvc71-ltcg-c-component'
    return ('standard-linked-c-component' if state['config']['mode'] == 'compiled-component-v1'
            else 'standard-linked-c-external')


def linking_record(r, build_manifest, state):
    spec = r['linking']
    if spec.get('schema_version') != 1:
        raise ValueError('Unsupported per-function linking record')
    record = dict(schema_version=1,
        candidate=dict(symbol=r['candidate_symbol'], section=spec['section'],
                       address=int(r['address'], 0), object_sha256=build_manifest['object_sha256']),
        bindings=spec['bindings'], excluded_contexts=spec.get('excluded_contexts', []),
        compiler_provenance=dict(profile=r['compiler_profile'], source_sha256=build_manifest['source_sha256'],
            compiler_driver_sha256=build_manifest['compiler_sha256'],
            compiler_identity_sha256=json_digest(build_manifest['compiler_identity']),
            compiler_profile_sha256=json_digest(build_manifest['compiler_profile_config'])),
        linker={k: state[k] for k in ('sha256', 'version', 'emulation')})
    if state['config']['mode'] in ('compiled-component-v1', 'native-msvc71-ltcg-component-v1'):
        record['retained_functions'] = spec['retained_functions']
    if state['config']['mode'] == 'native-msvc71-ltcg-component-v1':
        record['candidate']['size'] = r['size']
        record['linker'] = {k: state[k] for k in ('executable', 'sha256', 'version', 'emulation', 'identity')}
    return record


def report_is_fresh(r, report):
    try:
        b = report['build']
        profile = read(ROOT/'config/compilers.json')[r['compiler_profile']]
        linked = linker_state(r)
        headers = b['headers_sha256']
        if not isinstance(headers, dict) or set(headers) != set(r.get('known_structures', [])):
            return False
        if b.get('source_only_fallback_for') or b.get('source_only_compile'):
            return False
        if not (r.get('candidate_source') and r.get('binary_sha256') == report['binary_sha256']
            and b['source_sha256'] == file_digest(ROOT/r['candidate_source'])
            and all(file_digest(ROOT/h) == digest for h, digest in headers.items())
            and b.get('compiler_profile_config') == profile
            and b.get('compiler_sha256') == compiler_digest(profile['executable'])
            and b.get('compiler_identity') == compiler_identity(profile)
            and b.get('engine_sha256') == file_digest(ROOT/'tools/decomp')
            and b.get('function_record_sha256') == json_digest(r)
            and b.get('linker_state') == linked):
            return False
        mode = linked_method(linked) if linked else 'isolated-coff'
        if b.get('match_method') != mode or report.get('abi_compatible') != r.get('candidate_abi_compatible', False):
            return False
        out = ROOT/'build'/r['address']
        if file_digest(out/'candidate.bin') != b['candidate_sha256'] or file_digest(out/'candidate.obj') != b['object_sha256']:
            return False
        if linked:
            m = b['linking']
            expected = linking_record(r, b, linked)
            if (b['linking_record_sha256'] != json_digest(expected)
                    or m['compiler_provenance'] != expected['compiler_provenance']
                    or m['linker'] != {k: linked[k] for k in ('executable', 'sha256', 'version', 'emulation')}
                    or m['selected_section_name'] != r['linking']['section']
                    or m['linked_size'] != (out/'candidate.bin').stat().st_size):
                return False
            if m['linked_function_sha256'] != b['candidate_sha256'] or m['whole_input_size'] != m['linked_size'] or m['address'] != int(r['address'], 0):
                return False
            category = ('component-standard-linked-C-contribution-v1' if mode == 'standard-linked-c-component'
                        else 'external-standard-linked-C-contribution-v1')
            if mode == 'native-msvc71-ltcg-c-component':
                category = 'native-msvc71-ltcg-C-contribution-v1'
            if m['record_sha256'] != b['linking_record_sha256'] or m['category'] != category:
                return False
            if mode in ('standard-linked-c-component', 'native-msvc71-ltcg-c-component'):
                expected_contributions = {r['candidate_symbol']: (r['linking']['section'], int(r['address'], 0), m['whole_input_size'])}
                expected_contributions.update({h['symbol']: (h['section'], h['address'], h['size'])
                                               for h in r['linking']['retained_functions']})
                contributions = m['contributions']
                if (len(contributions) != len(expected_contributions)
                        or {c['symbol']: (c['section'], c['address'], c['size']) for c in contributions} != expected_contributions):
                    return False
                for contribution in m['contributions']:
                    if file_digest(out/'linked'/(contribution['section'][1:] + '.bin')) != contribution['sha256']:
                        return False
                helpers = report.get('compiled_dependencies', [])
                if len(helpers) != len(r['linking']['retained_functions']) or not all(h['exact_byte_match'] for h in helpers):
                    return False
                catalog = {entry['address']: entry for entry in read(ROOT/'config/functions.json')}
                if any(h['catalog_record_sha256'] != json_digest(catalog[h['address']]) for h in helpers):
                    return False
                expected_helpers = {hx(h['address']): h for h in r['linking']['retained_functions']}
                if {h['address'] for h in helpers} != set(expected_helpers):
                    return False
                for helper in helpers:
                    spec = expected_helpers[helper['address']]
                    contribution = next(c for c in contributions if c['symbol'] == spec['symbol'])
                    if helper['size'] != spec['size'] or helper['sha256'] != contribution['sha256']:
                        return False
            artifacts = [('candidate.exe', 'linked_image_sha256'), ('layout.ld', 'script_sha256'), ('link-input.obj', 'object_sha256')]
            if mode == 'native-msvc71-ltcg-c-component':
                artifacts = [('candidate.exe', 'linked_image_sha256'), ('layout.json', 'script_sha256'),
                             ('link-input.obj', 'object_sha256'), ('layout.obj', 'layout_object_sha256'),
                             ('native.map', 'map_sha256')]
                if (m.get('intermediate_format') != 'opaque-msvc71-GL'
                        or m.get('contribution_extent_source') != 'native-linker-map'
                        or any(m.get(k) is not False for k in ('normalization', 'object_byte_modification',
                                                             'original_byte_input', 'placement_space_counted'))):
                    return False
            for artifact, key in artifacts:
                if file_digest(out/'linked'/artifact) != m[key]:
                    return False
        elif b.get('linking') is not None:
            return False
        return True
    except (OSError, KeyError, ValueError, TypeError, subprocess.CalledProcessError):
        return False


def build(r):
    if not r.get('candidate_source'):
        raise ValueError('No candidate source')
    profile = read(ROOT/'config/compilers.json')[r['compiler_profile']]
    identity = compiler_identity(profile)
    source_hash = file_digest(ROOT/r['candidate_source'])
    header_hashes = {h: file_digest(ROOT/h) for h in r.get('known_structures', [])}
    driver_hash = compiler_digest(profile['executable'])
    out = private(ROOT/'build'/r['address'])
    out.mkdir(parents=True, exist_ok=True)
    obj = out/'candidate.obj'
    cmd = [profile['executable'], *profile['flags'], '-c', r['candidate_source'], '-o', str(obj)]
    env = dict(os.environ, SOURCE_DATE_EPOCH='0')
    subprocess.run(cmd, cwd=ROOT, env=env, check=True)
    if (source_hash != file_digest(ROOT/r['candidate_source'])
            or header_hashes != {h: file_digest(ROOT/h) for h in r.get('known_structures', [])}
            or driver_hash != compiler_digest(profile['executable'])
            or identity != compiler_identity(profile)
            or profile != read(ROOT/'config/compilers.json')[r['compiler_profile']]):
        raise ValueError('Source, headers or compiler changed during compilation')
    linked = None if r.get('source_only_compile') else linker_state(r)
    manifest = dict(command=cmd, compiler_version=subprocess.check_output([profile['executable'], '--version'], text=True),
                    source_sha256=source_hash, headers_sha256=header_hashes,
                    profile=r['compiler_profile'], source_date_epoch='0',
                    candidate_abi_compatible=r.get('candidate_abi_compatible', False),
                    compiler_profile_config=profile, compiler_sha256=driver_hash,
                    compiler_identity=identity, object_sha256=file_digest(obj),
                    source_only_fallback_for=r.get('source_only_fallback_for'),
                    source_only_compile=r.get('source_only_compile', False),
                    engine_sha256=file_digest(ROOT/'tools/decomp'),
                    function_record_sha256=json_digest(r), linker_state=linked)
    if r.get('source_only_compile'):
        manifest.update(match_method='source-only-object', candidate_sha256=None)
        write(out/'build.json', manifest)
        return obj.read_bytes(), manifest
    if linked:
        record = linking_record(r, manifest, linked)
        adapter = link_component_candidate if linked['config']['mode'] == 'compiled-component-v1' else link_external_candidate
        if linked['config']['mode'] == 'native-msvc71-ltcg-component-v1':
            adapter = link_ltcg_candidate
        data, evidence = adapter(obj, record, out/'linked', linker=linked['executable'])
        if linker_state(r) != linked:
            raise ValueError('Linker configuration or adapter changed during linking')
        manifest.update(match_method=linked_method(linked), linking=evidence,
                        linking_record_sha256=json_digest(record))
    else:
        data = coff_function(obj, r['candidate_symbol'])
        manifest.update(match_method='isolated-coff', linking=None)
    (out/'candidate.bin').write_bytes(data)
    manifest['candidate_sha256'] = hashlib.sha256(data).hexdigest()
    write(out/'build.json', manifest)
    return data, manifest


def build_all():
    candidates = [r for r in read(ROOT/'config/functions.json') if r.get('candidate_source')]
    for r in candidates:
        try:
            data, _ = build(r)
            print(f'{r["address"]}: compiled {len(data)} bytes')
        except OptionalCompilerUnavailable:
            profiles = read(ROOT/'config/compilers.json')
            fallback = profiles[r['compiler_profile']].get('optional_portable_profile')
            if not isinstance(fallback, str) or fallback not in profiles or fallback == r['compiler_profile']:
                raise
            portable = dict(r, compiler_profile=fallback,
                            source_only_fallback_for=r['compiler_profile'], source_only_compile=True,
                            match_expectation='exploratory')
            data, _ = build(portable)
            print(f'{r["address"]}: source compiled to {len(data)} object bytes '
                  f'(source-only fallback {fallback}; optional {r["compiler_profile"]} unavailable)')
    print(f'Compiled {len(candidates)} reviewed candidates')


def match(args):
    r = function(args.address)
    pe = binary(args.binary)
    if r.get('binary_sha256') != pe.metadata['sha256'] or not r.get('boundary_verified') or not r.get('size'):
        raise ValueError('Matching requires reviewed boundaries tied to this binary hash')
    data, manifest = build(r)
    dependencies = []
    if manifest['match_method'] in ('standard-linked-c-component', 'native-msvc71-ltcg-c-component'):
        catalog = {entry['address']: entry for entry in read(ROOT/'config/functions.json')}
        for helper in r['linking']['retained_functions']:
            key = hx(helper['address'])
            entry = catalog.get(key, {})
            if (entry.get('binary_sha256') != pe.metadata['sha256'] or not entry.get('boundary_verified')
                    or not entry.get('candidate_abi_compatible') or entry.get('size') != helper['size']
                    or entry.get('candidate_symbol') != helper['symbol']):
                raise ValueError('Compiled dependency needs a reviewed catalog region/ABI: ' + key)
            code = (ROOT/'build'/r['address']/'linked'/(helper['section'][1:] + '.bin')).read_bytes()
            checked = compare(pe.region(helper['address'], helper['size']), code, helper['address'])
            dependencies.append(dict(address=key, size=len(code), sha256=file_digest(
                ROOT/'build'/r['address']/'linked'/(helper['section'][1:] + '.bin')),
                exact_byte_match=checked['exact_byte_match'], catalog_record_sha256=json_digest(entry)))
            if not checked['exact_byte_match']:
                raise ValueError('Whole compiled dependency does not match: ' + key)
    result = compare(pe.region(int(r['address'], 0), r['size']), data, int(r['address'], 0))
    result.update(address=r['address'], binary_sha256=pe.metadata['sha256'], build=manifest,
                  abi_compatible=r.get('candidate_abi_compatible', False),
                  original_region_sha256=hashlib.sha256(pe.region(int(r['address'], 0), r['size'])).hexdigest())
    if dependencies:
        result['compiled_dependencies'] = dependencies
    out = private(ROOT/'analysis/matches'/f'{r["address"]}.json')
    write(out, result)
    print(json.dumps({k: result[k] for k in ('address', 'original_size', 'recompiled_size', 'exact_byte_match',
                                           'instruction_similarity', 'cfg_similarity', 'abi_compatible')}, indent=2))
    print(f'Disassembly and differences: {out.relative_to(ROOT)}')
    if getattr(args, 'require_exact', False) and not (result['exact_byte_match'] and result['abi_compatible']):
        raise ValueError(f'{r["address"]}: required exact match failed')
    return result


def verify_matches(args):
    summary_path = private(ROOT/'analysis/proof-of-concept.json')
    # Remove an earlier success before verification, so failures cannot leave a stale proof.
    summary_path.unlink(missing_ok=True)
    proof = [r for r in read(ROOT/'config/functions.json') if r.get('match_expectation') == 'exact']
    if not proof:
        raise ValueError('No exact-match expectations in the reviewed catalog')
    summary = []
    for r in proof:
        result = match(argparse.Namespace(address=r['address'], binary=args.binary, require_exact=True))
        summary.append({k: result[k] for k in ('address', 'original_size', 'recompiled_size', 'exact_byte_match', 'abi_compatible', 'original_region_sha256')} | {'match_method': result['build']['match_method']})
    write(summary_path, dict(schema_version=1,
          binary_sha256=summary and proof[0]['binary_sha256'], verified_exact_functions=len(summary),
          verified_by_method={method: sum(row['match_method'] == method for row in summary)
                              for method in sorted({row['match_method'] for row in summary})}, functions=summary))
    print(f'Verified {len(summary)} exact C-derived matches against the pinned executable')


def status():
    rs = records()
    counts = dict(total_candidate_functions=len(rs), total_program_functions=None,
                  identified=sum(r.get('confidence', 0) >= .8 for r in rs),
                  named=sum(bool(r.get('name')) and not r['name'].startswith('sub_') for r in rs),
                  prototype_known=sum(bool(r.get('prototype')) for r in rs),
                  source_reconstructed=sum(bool(r.get('candidate_source')) for r in rs),
                  compiling=0, semantic_match=0, assembly_partial_match=None, exact_match=0)
    for r in rs:
        p = ROOT/'analysis/matches'/f'{r["address"]}.json'
        if p.exists():
            m = read(p)
            fresh = report_is_fresh(r, m)
            if fresh:
                counts['compiling'] += 1
                counts['exact_match'] += int(m['exact_byte_match'] and m['abi_compatible'])
    print(json.dumps(counts, indent=2))


def task(args):
    record = function(args.address)
    r = record.copy()
    pe = binary(args.binary)
    if r.get('binary_sha256') != pe.metadata['sha256'] or not r.get('boundary_verified'):
        raise ValueError('Task requires reviewed region from pinned executable')
    from matching.compare import disassemble
    r['original_asm'] = disassemble(pe.region(int(r['address'], 0), r['size']), int(r['address'], 0))
    r['decompiler_output'] = None
    r['candidate_source_text'] = (ROOT/r['candidate_source']).read_text() if r.get('candidate_source') else None
    mp = ROOT/'analysis/matches'/f'{r["address"]}.json'
    report = read(mp) if mp.exists() else None
    current = report is not None and report_is_fresh(record, report)
    r['match_report'] = report if current else None
    r['match_report_current'] = current
    r['match_report_note'] = None if current else 'No fresh local match report; rerun matching'
    write(private(args.out), r)
    print(args.out)


def main():
    os.chdir(ROOT)
    p = argparse.ArgumentParser(description=__doc__)
    s = p.add_subparsers(dest='command', required=True)
    a = s.add_parser('analyze'); a.add_argument('--binary', default='original/StarCraft.exe'); a.add_argument('--out', default='analysis'); a.add_argument('--allow-unverified', action='store_true')
    for cmd in ('show', 'build', 'match', 'task'):
        a = s.add_parser(cmd); a.add_argument('address')
        if cmd in ('match', 'task'): a.add_argument('--binary', default='original/StarCraft.exe')
        if cmd == 'task': a.add_argument('--out', default='analysis/task.json')
        if cmd == 'match': a.add_argument('--require-exact', action='store_true')
    a = s.add_parser('verify-matches'); a.add_argument('--binary', default='original/StarCraft.exe')
    s.add_parser('build-all')
    s.add_parser('status'); s.add_parser('next')
    args = p.parse_args()
    try:
        if args.command == 'analyze': analyze(args)
        elif args.command == 'show': print(json.dumps(function(args.address), indent=2))
        elif args.command == 'build-all': build_all()
        elif args.command == 'build': print(f'Compiled {len(build(function(args.address))[0])} bytes')
        elif args.command == 'match': match(args)
        elif args.command == 'verify-matches': verify_matches(args)
        elif args.command == 'task': task(args)
        elif args.command == 'status': status()
        elif args.command == 'next':
            pending = [r for r in records() if r.get('status') != 'exact_match']
            print(json.dumps(pending[0] if pending else None, indent=2))
    except (ValueError, OSError, KeyError, subprocess.CalledProcessError) as e:
        p.exit(1, f'error: {e}\n')

if __name__ == '__main__': main()
