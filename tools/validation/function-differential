    fields[0], fields[1] = (rng.choice(link_pointers if encode else packed_links) for _ in range(2))
    fields[3] = rng.choice([0, 0x629D98, 0x629D98 - 1, 0x629D98 + 36 * 2499, 0xFFFFFFFF]
