def fixture(rng, count, rect, width, height):
    writes = []

    def put(address, fmt, *values):
        writes.append((address, struct.pack(fmt, *values)))

    put(RECT, '<4h', *rect)
    put(0x0066FF74, '<I', count)
    put(0x006BEE64, '<III', 3, width, 2)
    put(0x006BB930, '<I', height)
    ids = list(range(1, count + 1))
    rng.shuffle(ids)
    # Sorted paired tables deliberately have ties and independent sprite positions.
    for address in [0x0066FF78, 0x006769B8]:
        pairs = sorted((rng.randint(-100, 500), index) for index in ids)
        for slot, (value, index) in enumerate(pairs):
            put(address + slot * 8, '<Ii', index, value)
    for index in ids:
        unit = 0x0059CB58 + index * 336
        sprite = 0x00710000 + index * 32
        put(unit + 12, '<I', sprite)
        put(unit + 100, '<H', 0)
        put(sprite + 20, '<hh', rng.randint(-100, 500), rng.randint(-100, 500))
        put(0x006BD3D0 + index * 4, '<I', rng.choice([0, 1, 3, 7]))
    put(0x006617C8, '<hh', rng.randint(-20, 20), rng.randint(-20, 20))
    return writes


def path_fixture(rng, limit):
    writes = [(0x006D5BFC, struct.pack('<I', 0x006E0000)), (0x006E0000, struct.pack('<h', limit))]
    for pool in range(8):
        base = 0 if rng.randrange(4) == 0 else 0x00700000 + pool * 0x20000
        writes.append((0x0069A604 + pool * 4, struct.pack('<I', base)))
    for index in range(1000):
        next_id = rng.choice([0, 1, 999, 1000, 0xFFFFFFFF])
        previous_id = rng.choice([0, 1, 999, 1000, 0xFFFFFFFF])
        unit_id = rng.choice([0, 1, 1700, 0x800, 0xFFFFFFFF])
        path_id = rng.choice([0, 1, 2500, 2501, 19999, 20000, 640001, 0xFFFFFFFF])
        writes.append((0x006F0000 + index * 20, struct.pack('<IIIII', next_id, previous_id,
                                                        rng.getrandbits(32), unit_id, path_id)))
    writes.append((0x006F0000 + 20000, struct.pack('<I', rng.choice([0, 1, 1000, 0xFFFFFFFF]))))
    return writes



def packed_path_fixture(rng, limit, free_count):
    pool = 0x006F0000
    writes = [(0x006D5BFC, struct.pack('<I', 0x006E0000)),
              (0x006E0000, struct.pack('<h', limit))]
    # The original BYTE selector has no eight-pool check during encoding.
    for selector in range(256):
        writes.append((0x0069A604 + selector * 4,
                       struct.pack('<I', 0x00700000 + (selector % 8) * 0x18000)))
    free = rng.sample(range(1000), free_count)
    successors = {slot: pool + free[i + 1] * 20 if i + 1 < len(free) else 0
                  for i, slot in enumerate(free)}
    for slot in range(1000):
        unit_id = rng.choice([0, 1, 1700, 1701])
        unit = 0x0059CB58 + unit_id * 336 if unit_id else 0
        if unit:
            writes.append((unit + 165, struct.pack('<B', rng.randrange(256))))
        selector = rng.choice([0, 1, 7, 8, 255])
        index = rng.choice([0, 1, 2499, 2500, 3000])
        path = 0x00700000 + (selector % 8) * 0x18000 + index * 52
        writes.append((path + 4, struct.pack('<B', selector)))
        if rng.randrange(4) == 0:
            path = 0
        next_pointer = successors.get(slot, rng.choice([0, pool, pool + 19980]))
        previous_pointer = rng.choice([0, pool, pool + 19980])
        writes.append((pool + slot * 20, struct.pack('<IIIII', next_pointer,
                       previous_pointer, rng.getrandbits(32), unit, path)))
    writes.append((pool + 20000, struct.pack('<I', pool + free[0] * 20 if free else 0)))
    return writes

def state_pool_fixture(rng, free_count, serial):
    pool = 0x006F0000
    free = rng.sample(range(100), free_count)
    successors = {slot: pool + free[i + 1] * 460 if i + 1 < len(free) else 0
                  for i, slot in enumerate(free)}
    writes = []
    for slot in range(100):
        fields = [rng.getrandbits(32) for _ in range(115)]
        fields[0] = successors.get(slot, rng.choice([0, pool, pool + 99 * 460]))
        fields[1] = rng.choice([0, pool, pool + 99 * 460])
        for base_field, stride, base in [(2, 24, 0x006B5448), (4, 44, 0x0069F468)]:
            fields[base_field] = base
            fields[base_field + 1] = rng.choice([0, base, base + stride,
                                                base + 999 * stride, base - 1, base + 1])
        for field in [11, 12, 13, 14, 10, 9]:
            unit_id = rng.choice([0, 1, 2, 1700, 1701])
            unit = 0x0059CB58 + unit_id * 336 if unit_id else 0
            if unit:
                writes.append((unit + 165, struct.pack('<B', serial)))
            fields[field] = unit
        writes.append((pool + slot * 460, struct.pack('<115I', *fields)))
    writes.append((pool + 46000, struct.pack('<I', pool + free[0] * 460 if free else 0)))
    return writes


