def pool112_release_fixture(rng, number):
    base = 0x64B2E8
    slot = number % 100
    node = base + slot * 112
    data = bytearray(rng.randbytes(11232))
    globals0 = bytearray(rng.randbytes(32))
    globals1 = bytearray(rng.randbytes(32))
    for j in range(100):
        pointers = [rng.choice([0, base + rng.randrange(100) * 112]) for _ in range(2)]
        struct.pack_into('<II', data, 16 + j * 112, *pointers)
    struct.pack_into('<I', data, 16 + slot * 112 + 12,
                     [0, 0, 0, 1, 0, 0x80000000, 0, 0xFFFFFFFF][number // 100 % 8])
    position = 0 if number // 100 % 4 == 0 else base + ((number + 13) % 100) * 112
    struct.pack_into('<I', globals0, 4, rng.choice([node, 0, base]))
    struct.pack_into('<I', globals0, 28, rng.choice([node, 0, base]))
    struct.pack_into('<I', globals0, 20, [0, 1, 100, 0xFFFFFFFF][number // 100 % 4])
    struct.pack_into('<II', globals1, 8, position, rng.choice([position, 0, node]))
    return [(base - 16, bytes(data)), (0x64DEA8, bytes(globals0)),
            (0x64EED0, bytes(globals1))], node


def pool112_init_fixture(rng, number):
    data = bytearray(rng.randbytes(11232))
    pattern = number % 8
    if pattern == 0:
        data[:] = bytes(len(data))
    elif pattern == 1:
        data[:] = b'\xff' * len(data)
    elif pattern == 2:
        data[:] = bytes(j & 255 for j in range(len(data)))
    elif pattern == 3:
        data[:] = b'\x55\xaa' * (len(data) // 2)
    return [(0x64B2D8, bytes(data)), (0x64DEA8, rng.randbytes(32)),
            (0x64EED0, rng.randbytes(32))]


