        units[index * 336 + 77], units[index * 336 + 78] = [
            (0, 1), (0, 0), (1, 1), (1, 0), (255, 255)][(number + index) % 5]
        units[index * 336 + 165] = serials[(number + index) % 8]
    packed_links = [0, 1, 2, 99, 100, 101, 0xFFFFFFFF, 0x80000000, 0x40000000]
    link_pointers = [0, base, base + 112 * 99, base - 1, base + 1, 0xFFFFFFFF, 0x80000000]
